{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinemata.dev/schema/episode-manifest.schema.json",
  "title": "Cinemata Episode Manifest",
  "type": "object",
  "required": ["project", "episode", "scenes"],
  "additionalProperties": true,
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "episode": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri", "license"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["image", "video", "audio", "font", "other"]},
          "uri": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "source": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "shots"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "location": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "duration"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"type": "string"},
                "duration": {"type": "number", "exclusiveMinimum": 0},
                "prompt": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["shot_id", "text"],
              "properties": {
                "shot_id": {"type": "string", "minLength": 1},
                "character": {"type": "string"},
                "text": {"type": "string", "minLength": 1},
                "duration": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
